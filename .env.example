# ---- mode ----------------------------------------------------------------
# approve = fill everything, submit nothing (default, safe)
# auto    = fill everything, submit unless the gate blocks
MODE=approve

# ---- llm -----------------------------------------------------------------
# rules     = deterministic mapping only, no API key needed (default)
# anthropic = Claude API           (needs ANTHROPIC_API_KEY)
# openai    = OpenAI-compatible    (needs OPENAI_API_KEY, OPENAI_BASE_URL optional)
# ollama    = local model          (needs OLLAMA_HOST, nothing leaves the box)
LLM_PROVIDER=rules
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ---- runtime -------------------------------------------------------------
PROFILE_PATH=config/profile.json
DB_PATH=data/autoapply.sqlite
SCREENSHOT_DIR=data/screenshots
HEADLESS=1
# Hard cap on unattended submissions per rolling 24h. Kill switch: touch data/STOP
DAILY_SUBMIT_CAP=25
# Override the Chromium binary (leave unset to use Playwright's own download)
# AUTOAPPLY_CHROMIUM=/opt/pw-browsers/chromium-1194/chrome-linux/chrome

# ---- agent lane ----------------------------------------------------------
# Used for iCIMS, Ashby, Oracle/Taleo and unknown hosts, and as the fallback
# when a dedicated worker fills but fails verification. Requires an LLM.
AGENT_MAX_STEPS=40
AGENT_SUBMIT_STEPS=12
JUDGE_MAX_STEPS=10
# Persisted cookies, so a signed-in ATS session survives between runs
# STORAGE_STATE=data/storage_state.json

# --- Verification codes by email, via the Gmail API (preferred) -----------
# Ordinary HTTPS on 443, so it works anywhere the rest of the tool does --
# IMAP's port 993 is not routed in many sandboxes. Scope is gmail.readonly:
# it cannot send, delete or modify anything.
#   1. console.cloud.google.com -> new project -> enable the Gmail API
#   2. OAuth consent screen -> External -> add yourself as a test user
#   3. Credentials -> OAuth client ID -> Desktop app -> copy id + secret here
#   4. run `python -m autoapply mailauth` once, paste the token it prints
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# --- Verification codes by email, via IMAP (fallback) ---------------------
# Lets a run read a one-time code an ATS mails you, and nothing else: the
# mailbox is opened read-only, only messages arriving AFTER the wait starts are
# examined, only ones matching the run's filter are opened, and only the
# extracted code is returned. Use an app password, never the account password.
# Gmail: myaccount.google.com/apppasswords
MAIL_USER=
MAIL_APP_PASSWORD=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_MAILBOX=INBOX

# --- Reusing a signed-in session (optional) -------------------------------
# Sites with bot-detected logins (Google) are handled by signing in once by
# hand and reusing the saved session, rather than automating the password.
#   playwright open --save-storage=state.json https://accounts.google.com
# then point STORAGE_STATE at it.
STORAGE_STATE=
